
name: "wide_deep_ranker"
platform: "onnxruntime_onnx"
max_batch_size: 0

input [
  {
    name: "user_ids"
    data_type: TYPE_INT64
    dims: [-1]
  },
  {
    name: "movie_ids"
    data_type: TYPE_INT64
    dims: [-1]
  }
]

output [
  {
    name: "scores"
    data_type: TYPE_FP32
    dims: [-1]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
